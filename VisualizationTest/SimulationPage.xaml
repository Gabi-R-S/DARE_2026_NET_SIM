<Page x:Class="VisualizationTest.SimulationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:graph="clr-namespace:VisualizationTest.Graph"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Simulation Visualization"
      Background="#0B0F19">

    <Page.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation / Toolbar -->
        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Back & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}"
                            Content="← Back"
                            Click="BackButton_Click"
                            Margin="0,0,16,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Realtime Mesh Network Simulation"
                                   Foreground="#F8FAFC"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TopologySubtext"
                                   Text="Initializing..."
                                   Foreground="#94A3B8"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Simulation Actions & Routing Selector -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Protocol dropdown -->
                    <TextBlock Text="Protocol:"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,6,0"/>
                    <ComboBox x:Name="ProtocolComboBox"
                              Width="140"
                              Height="28"
                              SelectedIndex="0"
                              SelectionChanged="ProtocolComboBox_SelectionChanged"
                              Margin="0,0,12,0">
                        <ComboBoxItem Content="Flood Routing"/>
                        <ComboBoxItem Content="Distance Vector"/>
                        <ComboBoxItem Content="Link State"/>
                        <ComboBoxItem Content="No-Route (Ack)"/>
                        <ComboBoxItem Content="Base Layer Only"/>
                    </ComboBox>

                    <!-- Inject Manual App Op -->
                    <Button Style="{StaticResource AccentButton}"
                            Content="⚡ Inject App Op"
                            ToolTip="Manually triggers a new CRDT insert operation on a replica node"
                            Click="InjectAppOp_Click"
                            Margin="0,0,8,0"/>

                    <!-- Re-randomize / Restart -->
                    <Button Style="{StaticResource ModernButton}"
                            Content="🔄 Restart (New Random Mesh)"
                            ToolTip="Generates a new random network topology and restarts the realtime simulation"
                            Click="RestartSimulation_Click"
                            Margin="0,0,8,0"/>
                </StackPanel>

                <!-- Right: Viewport Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}"
                            Content="Zoom In (+)"
                            Click="ZoomIn_Click"
                            Margin="0,0,4,0"/>
                    <Button Style="{StaticResource ModernButton}"
                            Content="Zoom Out (-)"
                            Click="ZoomOut_Click"
                            Margin="0,0,4,0"/>
                    <Button Style="{StaticResource ModernButton}"
                            Content="Fit View"
                            Click="FitView_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Packet Color Legend Strip -->
        <Border Grid.Row="1"
                Background="#090D16"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Packet Colors:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- App Data Badge -->
                <Border Background="#10B981" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="App Data (CRDT)" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Ack Badge -->
                <Border Background="#A855F7" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: ACK" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Distance Vector / Route Badge -->
                <Border Background="#F97316" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: Route Update (DV)" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Link State Badge -->
                <Border Background="#F59E0B" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: LSA Broadcast" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Heartbeat Badge -->
                <Border Background="#0EA5E9" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: Heartbeat" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Node Status Badge -->
                <Border BorderBrush="#38BDF8" BorderThickness="1.5" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Active Node" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Border BorderBrush="#10B981" Background="#064E3B" BorderThickness="1.5" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Converged Node" Foreground="#6EE7B7" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Graph Visualization Canvas (Read-Only) -->
        <graph:NetworkGraphView x:Name="GraphViewControl"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BackgroundBrush="#0B0F19"
                                ShowGrid="True"/>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatsTextBlock"
                               Text="Packets: 0 | App: 0 | Protocol: 0 | In Flight: 0"
                               Foreground="#94A3B8"
                               FontSize="12"/>
                </StackPanel>

                <!-- Center: Node Convergence Status -->
                <TextBlock Grid.Column="1"
                           x:Name="ConvergenceTextBlock"
                           Text="Replicas Converged: 0/0 (0%)"
                           Foreground="#E2E8F0"
                           FontWeight="Medium"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Right: FPS & Sim Time -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SimTimeTextBlock"
                               Text="Time: 0.0s"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="FpsTextBlock"
                               Text="FPS: --"
                               Foreground="#38BDF8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>