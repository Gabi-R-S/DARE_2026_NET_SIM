<Page x:Class="VisualizationTest.SimulationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:graph="clr-namespace:VisualizationTest.Graph"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="Simulation Visualization"
      Background="#0B0F19">

    <Page.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox for Drawer -->
        <Style x:Key="DrawerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <Style x:Key="DrawerSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation / Toolbar -->
        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Back & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}"
                            Content="← Back"
                            Click="BackButton_Click"
                            Margin="0,0,16,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Realtime Mesh Network Simulation"
                                   Foreground="#F8FAFC"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TopologySubtext"
                                   Text="Initializing..."
                                   Foreground="#94A3B8"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Simulation Actions & Routing Selector -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Protocol dropdown -->
                    <TextBlock Text="Protocol:"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,6,0"/>
                    <ComboBox x:Name="ProtocolComboBox"
                              Width="140"
                              Height="28"
                              SelectedIndex="0"
                              SelectionChanged="ProtocolComboBox_SelectionChanged"
                              Margin="0,0,10,0">
                        <ComboBoxItem Content="Flood Routing"/>
                        <ComboBoxItem Content="Distance Vector"/>
                        <ComboBoxItem Content="Link State"/>
                        <ComboBoxItem Content="No-Route (Ack)"/>
                        <ComboBoxItem Content="Base Layer Only"/>
                    </ComboBox>

                    <!-- Inject Manual App Op -->
                    <Button Style="{StaticResource AccentButton}"
                            Content="⚡ Inject App Op"
                            ToolTip="Manually triggers a new CRDT insert operation on a replica node"
                            Click="InjectAppOp_Click"
                            Margin="0,0,6,0"/>

                    <!-- Restart current config -->
                    <Button Style="{StaticResource ModernButton}"
                            Content="🔄 Restart"
                            ToolTip="Restarts the simulation using current parameters"
                            Click="RestartSimulation_Click"
                            Margin="0,0,6,0"/>

                    <!-- New Random Seed & Restart -->
                    <Button Style="{StaticResource ModernButton}"
                            Content="🎲 New Seed"
                            ToolTip="Picks a new random seed and restarts the simulation"
                            Click="NewSeedRestart_Click"
                            Margin="0,0,6,0"/>

                    <!-- Toggle Parameters Panel -->
                    <Button x:Name="ToggleParametersButton"
                            Style="{StaticResource ModernButton}"
                            Content="⚙ Parameters"
                            ToolTip="Open live simulation parameters drawer"
                            Click="ToggleParameters_Click"/>
                </StackPanel>

                <!-- Right: Viewport Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}"
                            Content="Zoom In (+)"
                            Click="ZoomIn_Click"
                            Margin="0,0,4,0"/>
                    <Button Style="{StaticResource ModernButton}"
                            Content="Zoom Out (-)"
                            Click="ZoomOut_Click"
                            Margin="0,0,4,0"/>
                    <Button Style="{StaticResource ModernButton}"
                            Content="Fit View"
                            Click="FitView_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Packet Color Legend Strip -->
        <Border Grid.Row="1"
                Background="#090D16"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Packet Colors:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- App Data Badge -->
                <Border Background="#10B981" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="App Data (CRDT)" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Ack Badge -->
                <Border Background="#A855F7" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: ACK" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Distance Vector / Route Badge -->
                <Border Background="#F97316" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: Route Update (DV)" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Link State Badge -->
                <Border Background="#F59E0B" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: LSA Broadcast" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Heartbeat Badge -->
                <Border Background="#0EA5E9" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Protocol: Heartbeat" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Node Status Badge -->
                <Border BorderBrush="#38BDF8" BorderThickness="1.5" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Active Node" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Border BorderBrush="#10B981" Background="#064E3B" BorderThickness="1.5" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Converged Node" Foreground="#6EE7B7" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area: Graph Canvas + Collapsible Parameters Drawer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Graph Viewport -->
            <graph:NetworkGraphView x:Name="GraphViewControl"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    BackgroundBrush="#0B0F19"
                                    ShowGrid="True"/>

            <!-- Collapsible Live Parameters Drawer -->
            <Border x:Name="ParametersDrawer"
                    Grid.Column="1"
                    Width="320"
                    Background="#0F172A"
                    BorderBrush="#1E293B"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚙ Live Parameters"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource ModernButton}"
                                Content="✕"
                                Padding="8,3"
                                FontSize="11"
                                Click="CloseDrawer_Click"/>
                    </Grid>

                    <!-- Drawer Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Section: Network & Topology -->
                            <TextBlock Text="Topology &amp; Scale" Style="{StaticResource DrawerSection}"/>

                            <TextBlock Text="Number of Nodes (2 - 50)" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerNodesTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <TextBlock Text="Topology" Style="{StaticResource DrawerLabel}"/>
                            <ComboBox x:Name="DrawerTopologyComboBox" Height="26" SelectionChanged="DrawerTopologyComboBox_SelectionChanged">
                                <ComboBoxItem Content="Random Mesh"/>
                                <ComboBoxItem Content="Fully Connected"/>
                                <ComboBoxItem Content="Ring"/>
                                <ComboBoxItem Content="Star"/>
                                <ComboBoxItem Content="Line / Bus"/>
                            </ComboBox>

                            <TextBlock x:Name="DrawerExtraEdgeLabel" Text="Mesh Extra Link Probability" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerExtraEdgeTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <TextBlock Text="Randomness Seed" Style="{StaticResource DrawerLabel}"/>
                            <CheckBox x:Name="DrawerUseRandomSeedCheckBox"
                                      Content="Auto-randomize on restart"
                                      Foreground="#CBD5E1"
                                      FontSize="11"
                                      Margin="0,2,0,4"
                                      Checked="DrawerUseRandomSeed_Changed"
                                      Unchecked="DrawerUseRandomSeed_Changed"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DrawerSeedTextBox"
                                         Grid.Column="0"
                                         Height="26"
                                         Style="{StaticResource DrawerTextBox}"
                                         Margin="0,0,4,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ModernButton}"
                                        Content="🎲"
                                        Padding="8,2"
                                        Click="DrawerRandomizeSeed_Click"/>
                            </Grid>

                            <!-- Section: Delays -->
                            <TextBlock Text="Link Transmission Latencies" Style="{StaticResource DrawerSection}"/>

                            <TextBlock Text="Min Message Delay (s)" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerMinDelayTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <TextBlock Text="Max Message Delay (s)" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerMaxDelayTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <!-- Section: Routing & Timers -->
                            <TextBlock Text="Routing &amp; Protocol Timers" Style="{StaticResource DrawerSection}"/>

                            <TextBlock Text="Routing Protocol" Style="{StaticResource DrawerLabel}"/>
                            <ComboBox x:Name="DrawerProtocolComboBox" Height="26">
                                <ComboBoxItem Content="Flood Routing"/>
                                <ComboBoxItem Content="Distance Vector"/>
                                <ComboBoxItem Content="Link State"/>
                                <ComboBoxItem Content="No-Route (Ack)"/>
                                <ComboBoxItem Content="Base Layer Only"/>
                            </ComboBox>

                            <TextBlock Text="Heartbeat Interval (s)" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerHeartbeatTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <TextBlock Text="Message Timeout (s)" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerTimeoutTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <TextBlock Text="Max Hop Count / TTL" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerMaxHopsTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <!-- Section: Workload -->
                            <TextBlock Text="CRDT Replication Workload" Style="{StaticResource DrawerSection}"/>

                            <TextBlock Text="Operations Per Replica" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerOpsTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <TextBlock Text="Delay Between Ops (s)" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerDelayOpsTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>

                            <TextBlock Text="Delay Between Sends (s)" Style="{StaticResource DrawerLabel}"/>
                            <TextBox x:Name="DrawerDelaySendsTextBox" Height="26" Style="{StaticResource DrawerTextBox}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Footer / Apply Button -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="DrawerValidationTextBlock"
                                   Foreground="#EF4444"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,6"/>
                        <Button Style="{StaticResource AccentButton}"
                                Content="Apply &amp; Restart Simulation"
                                HorizontalAlignment="Stretch"
                                Click="DrawerApply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Stats & Seed Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatsTextBlock"
                               Text="Packets: 0 | App: 0 | Protocol: 0 | In Flight: 0"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,0,16,0"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="SeedBadgeTextBlock"
                                   Text="Seed: --"
                                   Foreground="#38BDF8"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Center: Node Convergence Status -->
                <TextBlock Grid.Column="1"
                           x:Name="ConvergenceTextBlock"
                           Text="Replicas Converged: 0/0 (0%)"
                           Foreground="#E2E8F0"
                           FontWeight="Medium"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Right: FPS & Sim Time -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SimTimeTextBlock"
                               Text="Time: 0.0s"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="FpsTextBlock"
                               Text="FPS: --"
                               Foreground="#38BDF8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>