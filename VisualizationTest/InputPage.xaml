<Page x:Class="VisualizationTest.InputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisualizationTest"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InputPage">

    <Grid Margin="20">
        <StackPanel Width="350"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">

            <TextBlock Text="Simulation Parameters"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Number of Nodes"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="NumberOfNodesTextBox"
                     Text="6"
                     Height="30"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Minimum Message Delay (seconds)"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="MinimumMessageDelayTextBox"
                     Text="0.5"
                     Height="30"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Maximum Message Delay (seconds)"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="MaximumMessageDelayTextBox"
                     Text="1.5"
                     Height="30"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Routing Protocol"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="RoutingProtocolComboBox"
                      Height="30"
                      SelectedIndex="0"
                      Margin="0,0,0,30">
                <ComboBoxItem Content="Flood Routing"/>
                <ComboBoxItem Content="Distance Vector"/>
                <ComboBoxItem Content="Link State"/>
            </ComboBox>

            <Button Height="32"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Click="StartSimulation_Click">
                Start Simulation
            </Button>

        </StackPanel>
    </Grid>
</Page>
